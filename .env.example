# EVA / ASTRI env example. Copy to .env and fill locally. Do not commit real .env.

# ASTRI credentials
ASTRI_USER=
ASTRI_PASS=

# 9router / OpenAI-compatible model endpoint
OPENAI_BASE_URL=http://100.126.242.108:20128/v1
OPENAI_API_KEY=
OPENAI_MODEL=9r

# AI helper for converters
EVA_AI_ASSIST=true
EVA_AI_MODEL=9r
EVA_AI_CONFIDENCE_MIN=0.80

# DXF conversion
DXF_CONVERSION_ENABLED=true

# Search
SEARXNG_URL=http://searxng:8080

# Google service account JSON path; do not paste JSON into chat
GOOGLE_APPLICATION_CREDENTIALS=/opt/eva/.secrets/google-service-account.json
