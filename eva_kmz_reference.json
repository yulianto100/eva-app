{
  "description": "EVA KMZ folder structure reference. AI uses this as few-shot template.",
  "samples": [
    {
      "type": "cluster_AE_multi_fdt",
      "file": "BKS005185 - PERUMAHAN GRIYA RESTU CIKARANG BEKASI.kmz",
      "structure": {
        "root_folder": "CLUSTER_NAME (e.g. BKS005185 - PERUMAHAN GRIYA RESTU CIKARANG BEKASI)",
        "subfolders": [
          {
            "folder": "FDT",
            "contents": "Point placemarks for each FDT (e.g. GRYRST.054, GRYRST.055, GRYRST.056)"
          },
          {
            "folder": "BOUNDARY CLUSTER",
            "contents": "Polygon - cluster boundary"
          },
          {
            "folder": "LINE A - FDT 1",
            "note": "Pattern: LINE {A|B} - FDT {N} where N = 1,2,3... per FDT",
            "subfolders": [
              {
                "folder": "BOUNDARY FAT",
                "contents": "Polygon per FAT area, named FAT A01, FAT A02, ... or FAT B01, FAT B02, ..."
              },
              {
                "folder": "FAT",
                "contents": "Point per FAT, named FAT A01, FAT A02, ..."
              },
              {
                "folder": "HP COVER",
                "note": "Subfolder per FAT code, NOT nested under FAT folder",
                "subfolders": [
                  {
                    "folder": "A01",
                    "contents": "Point placemarks (e.g. E2/17, E2/15, RK-47)"
                  },
                  {
                    "folder": "A02",
                    "contents": "Point placemarks"
                  }
                ]
              },
              {
                "folder": "HP UNCOVER",
                "contents": "Point placemarks not yet covered (can be empty)"
              },
              {
                "folder": "DISTRIBUTION CABLE",
                "contents": "LineString - cable from FDT, named like 'GRYRST.054 - CABLE LINE A (FO 48C/4T) - AE - 1852m'"
              },
              {
                "folder": "SLACK HANGER",
                "contents": "Point placemarks"
              },
              {
                "folder": "EXISTING POLE EMR 7-2.5",
                "contents": "Point placemarks (can be empty)"
              },
              {
                "folder": "EXISTING POLE EMR 7-3",
                "contents": "Point placemarks (can be empty)"
              },
              {
                "folder": "EXISTING POLE EMR 7-4",
                "contents": "Point placemarks (can be empty)"
              },
              {
                "folder": "EXISTING POLE EMR 9-4",
                "contents": "Point placemarks (can be empty)"
              },
              {
                "folder": "EXISTING POLE PARTNER 7-4",
                "contents": "Point placemarks (EXT.PLN.* naming)"
              },
              {
                "folder": "EXISTING POLE PARTNER 9-4",
                "contents": "Point placemarks (can be empty)"
              },
              {
                "folder": "NEW POLE 7-2.5",
                "contents": "Point placemarks (can be empty)"
              },
              {
                "folder": "NEW POLE 7-3",
                "contents": "Point placemarks (MR.* naming)"
              },
              {
                "folder": "NEW POLE 7-4",
                "contents": "Point placemarks (can be empty)"
              },
              {
                "folder": "NEW POLE 9-4",
                "contents": "Point placemarks (can be empty)"
              },
              {
                "folder": "SLING WIRE",
                "contents": "Point placemarks (can be empty)"
              }
            ]
          }
        ]
      },
      "line_naming": "LINE {A|B} - FDT {N}",
      "fat_naming": "FAT {A|B}{01,02,...}",
      "hp_cover_subfolder": "Direct FAT code name (A01, A02, B01, B02...)",
      "pole_naming": {
        "existing_partner": "EXT.PLN.{SITE}.{P{NNN}}",
        "new": "MR.{SITE}.{P{NNN}}"
      }
    },
    {
      "type": "cluster_AE_single_fdt",
      "file": "BKS004686 - CIBARUSAH JAYA RW 06 BEKASI.kmz",
      "structure": {
        "root_folder": "CLUSTER_NAME (e.g. BKS004686 - CIBARUSAH JAYA RW 06 BEKASI)",
        "subfolders": [
          {
            "folder": "BOUNDARY CLUSTER",
            "contents": "Polygon - cluster boundary"
          },
          {
            "folder": "FDT",
            "contents": "Point placemarks for single FDT (e.g. CBRJY06.043)"
          },
          {
            "folder": "LINE A",
            "note": "NO FDT suffix when only 1 FDT. Just 'LINE {A|B}'",
            "subfolders_same_as_multi": "Same subfolder structure as multi-FDT LINE (BOUNDARY FAT, FAT, HP COVER, etc.)"
          },
          {
            "folder": "LINE B",
            "note": "Same as LINE A - no FDT suffix"
          }
        ]
      },
      "line_naming": "LINE {A|B} (no FDT suffix for single FDT)",
      "fat_naming": "FAT {A|B}{01,02,...}",
      "hp_cover_subfolder": "Direct FAT code name (A01, A02, B01, B02...)"
    }
  ],
  "universal_rules": {
    "root_folders": ["BOUNDARY CLUSTER", "FDT"],
    "line_folders": ["LINE {A|B}", "LINE {A|B} - FDT {N}"],
    "standard_subfolders_per_line": [
      "BOUNDARY FAT",
      "FAT",
      "HP COVER",
      "HP UNCOVER",
      "DISTRIBUTION CABLE",
      "SLACK HANGER",
      "EXISTING POLE EMR 7-2.5",
      "EXISTING POLE EMR 7-3",
      "EXISTING POLE EMR 7-4",
      "EXISTING POLE EMR 9-4",
      "EXISTING POLE PARTNER 7-4",
      "EXISTING POLE PARTNER 9-4",
      "NEW POLE 7-2.5",
      "NEW POLE 7-3",
      "NEW POLE 7-4",
      "NEW POLE 9-4",
      "SLING WIRE"
    ],
    "hp_cover_fat_codes": "Direct child folders of HP COVER, named by FAT code (A01, A02, B01, etc.)",
    "distribution_cable_naming": "{FDT_HOSTNAME} - CABLE LINE {A|B} (FO {C}C/{T}T) - AE - {LENGTH}m",
    "fat_polygon_naming": "FAT {A|B}{01,02,...} as placemark name inside BOUNDARY FAT folder",
    "fat_point_naming": "{FDT_HOSTNAME}.{A|B}{01,02,...} inside FAT folder",
    "pole_naming_existing": "EXT.{VENDOR}.{SITE}.P{NNN}",
    "pole_naming_new": "MR.{SITE}.P{NNN}"
  }
}
