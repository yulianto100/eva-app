  "filename_rules": {
    "Cluster": {
      "pattern": "^[A-Z]{2,}\\d{4,}\\s*-\\s*(?!SF\\b).+$",
      "sample": "BKS005380 - PERUMAHAN KIRANA CIKARANG BEKASI.kmz",
      "checklist": [
        "Kode area/project di depan: BKS005380",
        "Separator: tanda strip (-)",
        "Nama project/lokasi lengkap",
        "Jangan pakai prefix SF untuk Cluster"
      ]
    },
    "Subfeeder": {
      "pattern": "^[A-Z]{2,}\\d{4,}\\s*-\\s*SF\\s+.+$",
      "sample": "BKS005380 - SF PERUMAHAN KIRANA CIKARANG BEKASI.kmz",
      "checklist": [
        "Kode area/project di depan: BKS005380",
        "Separator: tanda strip (-)",
        "Prefix SF setelah strip",
        "Nama project/lokasi lengkap"
      ]
    },
    "Feeder": {
      "pattern": "^[A-Z]{1,}\\d{4,}\\s*-\\s*[A-Z]+-(?:MAIN_FEEDER|HUBFEEDER|UPLINK)_\\w+_(?:OLT|SEGMENT|FO|\\d+C)\\w*(?:\\.\\w+)?$",
      "sample": "FBKS0152 - BEKASI-MAIN_FEEDER_OLT_CIKARANG_UTARA_SEGMENT_3_TO_PASIRGOMBONG_FO_144C.kmz",
      "checklist": [
        "Kode feeder di depan: FBKS0152",
        "Mengandung MAINFEEDER / HUBFEEDER / UPLINK",
        "Mengandung OLT/Segment/destination",
        "Mengandung kapasitas kabel: 144C / 288C"
      ]
    }
  }
